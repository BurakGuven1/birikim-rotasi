# Tüm anahtarlar isteğe bağlıdır. Bu dosyayı .env.local adıyla kopyalayın.
# Anahtarları tırnak içine almanız gerekmez.

# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# https://eodhd.com/developer/api-keys
EODHD_API_KEY=

# https://massive.com/dashboard/api-keys · yalnız sunucu
MASSIVE_API_KEY=
# Hesabınızın izin verdiği istek sayısı; varsayılan ücretsiz paket sınırı
MASSIVE_REQUESTS_PER_MINUTE=5

# OKX bot: sunucu tarafında okunur. Paper mod için anahtar gerekmez.
# Passphrase API anahtarı oluştururken belirlenen API parolasıdır, hesap giriş parolası değildir.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Mevcut OKX_SECRET_KEY ve OKX_PASSPHRASE isimleri de desteklenir.
# Gerçek anahtar demo hesabın yerine kullanılamaz.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
# global, us, eea, tr — hesabın bağlı olduğu OKX bölgesi
OKX_REGION=global

# Bigdata.com, CoinMarketCap ve Financial Datasets bu sürümde yalnızca
# ChatGPT Work araştırma bağlayıcılarıdır; anahtarları bu dosyaya eklemeyin.
