//@version=6
// Özgürlük Rotası — Aylık Rejim Paneli (gösterge)
// Çekirdek kuralı: tamamlanmış ay kapanışı SMA10'un üstünde mi (0.5) + 12 aylık getiri pozitif mi (0.5).
// Skor 1 = AÇIK (tam ağırlık), 0.5 = YARIM, 0 = KAPALI (trend yarısı nakit veya perp short hedge).
indicator("Özgürlük Rotası Rejim", overlay = true)

hybridFloor = input.float(0.5, "Hep tutulan pay (Trinity)", minval = 0, maxval = 1)

mClose = request.security(syminfo.tickerid, "M", close[1], lookahead = barmerge.lookahead_on)
mSma10 = request.security(syminfo.tickerid, "M", ta.sma(close, 10)[1], lookahead = barmerge.lookahead_on)
mMom12 = request.security(syminfo.tickerid, "M", (close[1] / close[13]) - 1, lookahead = barmerge.lookahead_on)
score = (mClose > mSma10 ? 0.5 : 0.0) + (mMom12 > 0 ? 0.5 : 0.0)
exposure = hybridFloor + (1 - hybridFloor) * score

plot(mSma10, "SMA10 (aylık)", color.new(color.orange, 0), 2, plot.style_stepline)
bgcolor(score == 1 ? color.new(color.green, 90) : score == 0 ? color.new(color.red, 90) : color.new(color.yellow, 92))

var table t = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "Rejim", text_color = color.white)
    table.cell(t, 1, 0, score == 1 ? "AÇIK" : score == 0 ? "KAPALI" : "YARIM", text_color = score == 1 ? color.lime : score == 0 ? color.red : color.yellow)
    table.cell(t, 0, 1, "Ay sonu / SMA10", text_color = color.white)
    table.cell(t, 1, 1, str.tostring(mClose, format.mintick) + " / " + str.tostring(mSma10, format.mintick), text_color = color.white)
    table.cell(t, 0, 2, "12a momentum", text_color = color.white)
    table.cell(t, 1, 2, str.tostring(mMom12 * 100, "#.#") + "%", text_color = color.white)
    table.cell(t, 0, 3, "Hedef maruziyet", text_color = color.white)
    table.cell(t, 1, 3, str.tostring(exposure * 100, "#") + "%", text_color = color.white)

alertcondition(ta.change(score) != 0, "Rejim değişti", "Özgürlük Rotası: {{ticker}} aylık rejim değişti")
