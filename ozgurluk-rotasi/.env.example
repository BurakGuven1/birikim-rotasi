# Bu dosyayı .env adıyla kopyalayın. .env Git tarafından yok sayılır.
# Hiçbir anahtar zorunlu değildir: fiyatlar Yahoo + OKX açık uçlarından, TÜFE FRED CSV'den alınır.

# İsteğe bağlı veri anahtarları (varsa yedek/ana kaynak olarak kullanılır)
FRED_API_KEY=
EODHD_API_KEY=
ALPHA_VANTAGE_API_KEY=
MASSIVE_API_KEY=
COINMARKETCAP_API_KEY=

# Claude AI analist (Haberler & AI sayfası): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Key bir workspace'e bağlı değilse: console.anthropic.com → Settings → Workspaces'taki ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=
# İsteğe bağlı model değişikliği (varsayılan claude-opus-5-5)
CLAUDE_MODEL=
# Düşünme eforu: low | medium | high | max (varsayılan low — ucuz ve hızlı)
CLAUDE_EFFORT=
# Doluysa Claude yalnızca bu erişim anahtarını girenlere açılır (uzun, tahmin edilemez bir değer seçin)
AI_ACCESS_CODE=

# OKX — önce YALNIZCA "Read" yetkili bir anahtar oluşturun. Trade yetkisi ancak
# canlı emir istiyorsanız; Withdraw yetkisini ASLA vermeyin. IP kısıtı ekleyin.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 1 yapılmadıkça hiçbir emir borsaya gönderilmez (yalnız önizleme).
OKX_LIVE=0
# Canlı modda tek emrin USD üst sınırı (güvenlik freni)
OKX_MAX_ORDER_USD=1500

# TradingView webhook alıcısı için paylaşılan gizli anahtar
WEBHOOK_SECRET=
